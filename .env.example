# GEMINI_API_KEY: Optional fallback for AI chat
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ============================================================
# AiMeeting —— 模板（真实值只放 .env，禁止提交）
# 最后更新：2026-10-15（密钥轮换 + Endpoint + RTC 新应用）
# ============================================================

# ---------- 豆包语音（Speech）统一鉴权（新版控制台 X-Api-Key） ----------
DOUBAO_SPEECH_API_KEY=
# AiMeeting 应用数字 AppID（须与 API Key 同一应用）
DOUBAO_SPEECH_APP_ID=

# ---------- 端到端实时语音 Dialog（全双工，Seeduplex 3.0） ----------
DOUBAO_DUPLEX_MODEL=1.2.6.1
DOUBAO_DUPLEX_VOICE=zh_female_vv_jupiter_bigtts
DOUBAO_DUPLEX_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue

# ---------- 副驾驶建议卡（旁路 UI，默认开；不改口播 decideSpeak） ----------
# COPILOT_ENABLED=1
# COPILOT_ENABLED=0
# 双通道 Me 第二路 ASR（默认开；并发紧张时可关）
# DUAL_TRACK_ME_ASR=0

# ---------- TTS（独立模式 P2，seed-tts-2.0） ----------
# HOST_TTS_MODE=independent：独立单向 TTS，消费 seed-tts-2.0 字符额度，不与 Dialog 共享配额桶。
# text_words_lifetime=字符总量（资源包/后付费），不是并发；换 Key/应用/speaker 不能重置；生效约 5–10 分钟。
HOST_TTS_MODE=independent
# 优先 DOUBAO_TTS_API_KEY；未设则回退 DOUBAO_SPEECH_API_KEY
# DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# 优先 DOUBAO_TTS_SPEAKER（须为 2.0 音色）；未设则回退 DOUBAO_TTS_VOICE
# DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts
DOUBAO_TTS_SAMPLE_RATE=24000
# 单次合成文本上限（字符）；超出按标点分片
# DOUBAO_TTS_TEXT_MAX=1000
DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection

# ---------- BYOK（大模型，当前仅豆包方舟） ----------
# LLM_PROVIDER=doubao
# 统一 Key/地址（优先）；未设则回退下方 DOUBAO_*/ARK_*
# LLM_API_KEY=
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxxxxxx
# LLM_MODEL_FAST=ep-xxxxxxxx
# 其它供应商（openai/deepseek/ollama）已预留枚举，账号未接入前勿切换

# ---------- 方舟（Ark）基础配置 ----------
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VoiceChat 专用
ARK_API_KEY=
# LLM / Embedding 通用
DOUBAO_API_KEY=

# ---------- 大模型分层（全部用 Endpoint ID，不要直接写模型名） ----------
DOUBAO_CHAT_FAST_MODEL=ep-xxxxxxxx
DOUBAO_CHAT_MODEL=ep-xxxxxxxx
DOUBAO_CHAT_DEEP_MODEL=ep-xxxxxxxx
DOUBAO_EMBED_MODEL=doubao-embedding-vision
DOUBAO_EMBED_ENDPOINT=ep-xxxxxxxx
# L3 Deep Thinking：enabled（默认）/ 设 BIZ_DEEP_THINKING=0 关闭
# BIZ_DEEP_THINKING=0
# L2 默认 thinking.type=disabled；若要 L2 也开深度思考：BIZ_L2_THINKING=1
# BIZ_L2_THINKING=1

BIZ_LLM_TIMEOUT_MS=20000
BIZ_DEEP_TIMEOUT_MS=120000

# ---------- RTC（dazhiMeeting） ----------
RTC_APP_ID=
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=
ARK_ENDPOINT_ID=ep-20260928112753-fqzc7
DAZHI_BOT_USER_ID=dazhi-ai-bot
RTC_VOICECHAT_CALLBACK_SECRET=

# ---------- Phase B：独立会场听写 ASR ----------
# independent=云端豆包 SAUC；local=本地 Whisper；dialog=走 Seeduplex
HOST_ASR_MODE=independent
# HOST_ASR_MODE=local
# HOST_ASR_BACKEND=whisper
# --- 本地 Whisper（二选一）---
# 推荐：常驻 whisper.cpp server
# WHISPER_SERVER_URL=http://127.0.0.1:8080
# 或 CLI：先 npm run whisper:model，再指定可执行文件
# WHISPER_BIN=E:/tools/whisper.cpp/build/bin/whisper-cli.exe
# WHISPER_MODEL=E:/project/-ECE-Brain-Meeting/desktop/models/whisper/ggml-base.bin
# WHISPER_LANG=zh
# VAD：auto=尝试 Silero（需 onnxruntime-node + SILERO_VAD_MODEL）否则能量 VAD
# VAD_BACKEND=auto
# SILERO_VAD_MODEL=
# VAD_RMS_SPEECH=0.012
# VAD_SILENCE_MS=480
# ASR_GLOSSARY_PATH=   # 默认 desktop/dev_knowledge/glossary/project_terms.json
# 副驾驶：COPILOT_ENABLED=0 关闭；COPILOT_TRIGGER_MODE=manual 仅 Alt+Z 出卡
# COPILOT_ENABLED=1
# COPILOT_TRIGGER_MODE=auto
# 截屏 OCR（Windows WinRT；需系统 OCR 语言包）：SCREEN_OCR=1
# SCREEN_OCR=0
# Wiki2：WIKI2_INGEST_LLM=1 强制豆包编译；0=仅规则；不设则有 Key 时 auto
# WIKI2_INGEST_LLM=0
# DOUBAO_ASR_API_KEY=   # 可复用 DOUBAO_SPEECH_API_KEY
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# 仅当必须走旧版 AppID+AccessToken 时设 1（勿与新版 Key 混用）
# DOUBAO_ASR_LEGACY_AUTH=1

# ---------- 火山引擎 OpenAPI（IAM 子用户，禁止主账号 AK/SK） ----------
VOLC_REGION=cn-north-1
VOLC_ACCESSKEY=
VOLC_SECRETKEY=

PORT=8080
LOG_LEVEL=info

# E1 persistent backend (Railway)
FRONTEND_ORIGIN="https://dadimeeting.minervaedu.app"
VITE_API_BASE=""

ENABLE_LEGACY_TRTC=false

# Phase-1 / E1：Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

APP_URL="https://dadimeeting.minervaedu.app"

TRTC_SECRET_ID=""
TRTC_SECRET_KEY=""
TRTC_SDK_APP_ID=""

TENCENT_MEETING_CORP_ID=""
TENCENT_MEETING_APP_ID=""
TENCENT_MEETING_SECRET_ID=""
TENCENT_MEETING_SECRET_KEY=""
TENCENT_MEETING_HOST_USER_ID=""
TENCENT_MEETING_API_BASE="https://api.meeting.qq.com"
