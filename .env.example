# GEMINI_API_KEY: Optional fallback for AI chat
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Doubao / 火山方舟（RAG Embedding + AI 文本控场）
DOUBAO_API_KEY="05a5b825-69f6-40ff-93e9-7493c05e4fb0"
ARK_API_KEY="05a5b825-69f6-40ff-93e9-7493c05e4fb0"
DOUBAO_CHAT_MODEL="doubao-seed-evolving"
DOUBAO_CHAT_FAST_MODEL=""
# L3 与 L2 可用同一模型；靠 thinking.type 区分（evolving 仅支持 enabled|disabled，默认 enabled）
# https://docs.volcengine.com/docs/82379/1449737
DOUBAO_CHAT_DEEP_MODEL="doubao-seed-evolving"
BIZ_LLM_TIMEOUT_MS=35000
BIZ_DEEP_TIMEOUT_MS=120000
# L2 优先用快答；经营顾问 chatModelL2 已优先读 DOUBAO_CHAT_FAST_MODEL
# DOUBAO_CHAT_FAST_MODEL=ep-xxxxxxxx
# L3 Deep Thinking：enabled（默认）/ 设 BIZ_DEEP_THINKING=0 关闭
# BIZ_DEEP_THINKING=0
# L2 默认 thinking.type=disabled；若要 L2 也开深度思考：BIZ_L2_THINKING=1
# BIZ_L2_THINKING=1
DOUBAO_EMBED_MODEL="doubao-embedding-vision-251215"
# 临时多模态向量接口（semanticRag 默认已用；以后可改回标准 /embeddings）
# DOUBAO_EMBED_URL="https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal"
DOUBAO_MODEL_ENDPOINT="doubao-seed-evolving"

# 豆包实时语音 3.0 Seeduplex（全双工）— 语音控制台 API Key，不是方舟 Ark Key
# Docs: https://www.volcengine.com/docs/6561/2549732
# Endpoint: wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
DOUBAO_SPEECH_API_KEY="22bcaa65-23fe-42c1-88af-ab526d5ef0a0"
DOUBAO_SPEECH_APP_ID="3634679731"
DOUBAO_DUPLEX_MODEL="1.2.6.1"
DOUBAO_DUPLEX_VOICE="zh_female_vv_jupiter_bigtts"

# E1 persistent backend (Railway)
PORT=3000
FRONTEND_ORIGIN="https://dadimeeting.minervaedu.app"
# Browser API origin when SPA and API are split. Empty = same origin (Vercel rewrite → Railway).
VITE_API_BASE=""
# After E1: Vercel rewrites /api/* to https://api-production-6cca.up.railway.app

# E2 火山 RTC（多方实时语音；AppKey 仅服务端）
VOLC_RTC_APP_ID=""
VOLC_RTC_APP_KEY=""
ENABLE_LEGACY_TRTC=false

# Phase-1 / E1：Upstash Redis（生产必填；禁止用内存 Map 做多端状态）
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

APP_URL="https://dadimeeting.minervaedu.app"

TRTC_SECRET_ID=""
TRTC_SECRET_KEY=""
TRTC_SDK_APP_ID=""

TENCENT_MEETING_CORP_ID=""
TENCENT_MEETING_APP_ID=""
TENCENT_MEETING_SECRET_ID=""
TENCENT_MEETING_SECRET_KEY=""
TENCENT_MEETING_HOST_USER_ID=""
