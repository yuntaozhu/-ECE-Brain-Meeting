# GEMINI_API_KEY: Optional fallback for AI chat
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ============================================================
# AiMeeting —— 模板（真实值只放 .env，禁止提交）
# 最后更新：2026-10-15（密钥轮换 + Endpoint + RTC 新应用）
# ============================================================

# ---------- 豆包语音（Speech）统一鉴权（新版控制台 X-Api-Key） ----------
DOUBAO_SPEECH_API_KEY=
# AiMeeting 应用数字 AppID（须与 API Key 同一应用）
DOUBAO_SPEECH_APP_ID=

# ---------- 端到端实时语音 Dialog（全双工，Seeduplex 3.0） ----------
DOUBAO_DUPLEX_MODEL=1.2.6.1
DOUBAO_DUPLEX_VOICE=zh_female_vv_jupiter_bigtts
DOUBAO_DUPLEX_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue

# ---------- TTS（独立模式 P2，seed-tts-2.0） ----------
HOST_TTS_MODE=independent
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection

# ---------- 方舟（Ark）基础配置 ----------
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VoiceChat 专用
ARK_API_KEY=
# LLM / Embedding 通用
DOUBAO_API_KEY=

# ---------- 大模型分层（全部用 Endpoint ID，不要直接写模型名） ----------
DOUBAO_CHAT_FAST_MODEL=ep-xxxxxxxx
DOUBAO_CHAT_MODEL=ep-xxxxxxxx
DOUBAO_CHAT_DEEP_MODEL=ep-xxxxxxxx
DOUBAO_EMBED_MODEL=doubao-embedding-vision
DOUBAO_EMBED_ENDPOINT=ep-xxxxxxxx
# L3 Deep Thinking：enabled（默认）/ 设 BIZ_DEEP_THINKING=0 关闭
# BIZ_DEEP_THINKING=0
# L2 默认 thinking.type=disabled；若要 L2 也开深度思考：BIZ_L2_THINKING=1
# BIZ_L2_THINKING=1

BIZ_LLM_TIMEOUT_MS=20000
BIZ_DEEP_TIMEOUT_MS=120000

# ---------- RTC（dazhiMeeting） ----------
RTC_APP_ID=
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=
ARK_ENDPOINT_ID=ep-20260928112753-fqzc7
DAZHI_BOT_USER_ID=dazhi-ai-bot
RTC_VOICECHAT_CALLBACK_SECRET=

# ---------- Phase B：独立会场听写 ASR ----------
HOST_ASR_MODE=independent
# DOUBAO_ASR_API_KEY=   # 可复用 DOUBAO_SPEECH_API_KEY
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# 仅当必须走旧版 AppID+AccessToken 时设 1（勿与新版 Key 混用）
# DOUBAO_ASR_LEGACY_AUTH=1

# ---------- 火山引擎 OpenAPI（IAM 子用户，禁止主账号 AK/SK） ----------
VOLC_REGION=cn-north-1
VOLC_ACCESSKEY=
VOLC_SECRETKEY=

PORT=8080
LOG_LEVEL=info

# E1 persistent backend (Railway)
FRONTEND_ORIGIN="https://dadimeeting.minervaedu.app"
VITE_API_BASE=""

ENABLE_LEGACY_TRTC=false

# Phase-1 / E1：Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

APP_URL="https://dadimeeting.minervaedu.app"

TRTC_SECRET_ID=""
TRTC_SECRET_KEY=""
TRTC_SDK_APP_ID=""

TENCENT_MEETING_CORP_ID=""
TENCENT_MEETING_APP_ID=""
TENCENT_MEETING_SECRET_ID=""
TENCENT_MEETING_SECRET_KEY=""
TENCENT_MEETING_HOST_USER_ID=""
TENCENT_MEETING_API_BASE="https://api.meeting.qq.com"
