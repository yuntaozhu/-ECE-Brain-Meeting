{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XiaoxingPestAlert",
  "type": "object",
  "required": ["province", "publish_date", "pest_or_disease", "source_url"],
  "properties": {
    "province": { "type": "string" },
    "publish_date": { "type": "string" },
    "alert_level": { "type": "string" },
    "crop_affected": { "type": "array", "items": { "type": "string" } },
    "pest_or_disease": { "type": "string" },
    "affected_cities": { "type": "array", "items": { "type": "string" } },
    "impact_window": { "type": "string" },
    "supply_risk_summary": { "type": "string" },
    "source_url": { "type": "string" },
    "source_id": { "type": "string" },
    "fetched_at": { "type": "string" },
    "needs_review": { "type": "boolean" }
  }
}
