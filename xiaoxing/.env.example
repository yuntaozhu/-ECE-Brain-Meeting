# Firecrawl：https://www.firecrawl.dev — 勿提交真实 key
FIRECRAWL_API_KEY=fc-your-key-here

# 可选：HTTP 服务
XIAOXING_PORT=3780
# 微信回调需公网时改为 0.0.0.0，并配合 ngrok/反代
XIAOXING_HOST=127.0.0.1

# 微信公众号（见 docs/wechat-public.md）
WECHAT_TOKEN=your-wechat-token
# 安全模式（可选，43 位 EncodingAESKey）
# WECHAT_APP_ID=wx........
# WECHAT_AES_KEY=
# 本地联调可跳过验签（公网务必删除/设 0）：WECHAT_SKIP_VERIFY=1
# 缺口/拒答写入农服跟进：WECHAT_FOLLOWUP_ON_GAP=1

# 语音 TTS + 会场云 ASR（豆包/火山；也可只配仓库根 .env）
# 不使用本地 Whisper。ASR 与 TTS 可共用 SPEECH key。
# DOUBAO_SPEECH_API_KEY=
# DOUBAO_ASR_API_KEY=
# DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts
# DOUBAO_TTS_SAMPLE_RATE=24000

# 审定库未命中时的 LLM 参考答复（方舟 OpenAI 兼容；与 desktop 同套变量名，独立实现）
# LLM_PROVIDER=doubao
# LLM_API_KEY=   # 或 DOUBAO_API_KEY / ARK_API_KEY
# LLM_MODEL=     # 或 DOUBAO_CHAT_MODEL / DOUBAO_MODEL_ENDPOINT（ep-xxx）
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# XIAOXING_LLM_ON_GAP=1   # 设 0 可强制关闭缺口补答
