{
  "name": "ece-brain-meeting-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "腾讯会议 × 豆包：虚拟声卡音频网桥（P0 回环 / P1 全双工）",
  "main": "main.cjs",
  "scripts": {
    "start": "chcp 65001>nul & electron .",
    "build:kb": "node scripts/build-kb.cjs",
    "rag:index": "node scripts/build-rag-index.cjs",
    "rag:index:force": "node scripts/build-rag-index.cjs --force",
    "knowledge:promote": "node scripts/promote-inbox.cjs",
    "knowledge:promote:faq": "node scripts/promote-inbox.cjs --faq",
    "knowledge:promote:dry": "node scripts/promote-inbox.cjs --dry",
    "knowledge:distill": "node scripts/distill-chains.cjs",
    "knowledge:distill:all": "node scripts/distill-chains.cjs --all",
    "knowledge:distill:rule": "node scripts/distill-chains.cjs --force-rule",
    "knowledge:distill:dry": "node scripts/distill-chains.cjs --dry --force-rule",
    "knowledge:wiki:ingest": "node scripts/wiki-ingest.cjs",
    "knowledge:wiki:ingest:dry": "node scripts/wiki-ingest.cjs --dry",
    "knowledge:wiki:lint": "node scripts/wiki-lint.cjs",
    "knowledge:wiki:bootstrap": "node scripts/bootstrap-wiki.cjs",
    "knowledge:session": "node scripts/promote-session.cjs --latest",
    "knowledge:session:faq": "node scripts/promote-session.cjs --latest --faq --summary",
    "knowledge:session:all": "node scripts/promote-session.cjs --all --faq --summary",
    "knowledge:session:dry": "node scripts/promote-session.cjs --latest --dry",
    "rag:eval": "node scripts/eval-rag.cjs",
    "dialog:eval": "node scripts/eval-dialog.cjs",
    "dialog:eval:long": "node scripts/eval-p0-long.cjs",
    "dialog:eval:scene": "node scripts/eval-quan-yuan-scene.cjs",
    "agent:eval": "node scripts/eval-agent-variants.cjs",
    "agent:eval:live": "node scripts/eval-agent-variants.cjs --live",
    "smoke": "node scripts/smoke-regression.cjs",
    "smoke:chain": "node scripts/smoke-chain-follow.cjs",
    "tts:smoke": "node scripts/tts-smoke.cjs",
    "smoke:copilot": "node scripts/smoke-copilot-gate.cjs",
    "whisper:model": "node scripts/download-whisper-model.cjs",
    "whisper:smoke": "node scripts/whisper-smoke.cjs",
    "smoke:wave-a": "node scripts/smoke-wave-a.cjs",
    "smoke:wave-b": "node scripts/smoke-wave-b.cjs",
    "smoke:wave-c": "node scripts/smoke-wave-c.cjs",
    "smoke:wave-d": "node scripts/smoke-wave-d.cjs",
    "smoke:wave-e": "node scripts/smoke-wave-e.cjs",
    "smoke:wave-f": "node scripts/smoke-wave-f.cjs",
    "wiki2:index": "node scripts/wiki2-index.cjs",
    "wiki2:ingest": "node scripts/wiki2-ingest.cjs --dry",
    "wiki2:ingest:apply": "node scripts/wiki2-ingest.cjs --apply",
    "wiki2:ingest:llm": "node scripts/wiki2-ingest.cjs --dry --llm",
    "wiki2:themes": "node scripts/wiki2-themes.cjs --dry",
    "wiki2:themes:write": "node scripts/wiki2-themes.cjs",
    "wiki2:from-session": "node scripts/wiki2-from-session.cjs",
    "mcp:meeting": "node scripts/meeting-context-mcp.cjs",
    "test:bench": "node test/benchmarkRunner.cjs",
    "test:lint:hardcode": "node test/no-hardcode-lint.cjs",
    "pack": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis --config.win.signAndEditExecutable=false",
    "pack:portable": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable --config.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.4",
    "dotenv": "^17.2.3",
    "iconv-lite": "^0.7.3",
    "ws": "^8.20.1"
  },
  "build": {
    "appId": "app.minervaedu.ece-brain-bridge",
    "productName": "ECE-Brain Meeting Bridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "main/**/*",
      "preload.cjs",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "knowledge",
        "to": "knowledge",
        "filter": [
          "**/*",
          "**/.*",
          "**/.rag-index.json",
          "**/.gitkeep"
        ]
      },
      {
        "from": "knowledge/.rag-index.json",
        "to": "knowledge/rag-index.json"
      },
      {
        "from": "../.env",
        "to": ".env"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "大智会议顾问",
      "artifactName": "Dazhi-Meeting-Setup-${version}.${ext}"
    }
  }
}
